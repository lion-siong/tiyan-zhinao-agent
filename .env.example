# 安全提示：复制本文件为 .env 后再填入真实值。
# .env 只保存在本机，禁止提交、截图、录屏或发送到聊天工具。
# 如果密钥曾出现在聊天记录、日志或公开仓库中，应立即吊销并重新生成。

# 可选：OpenAI 或兼容服务提供的 API Key；留空时使用明确标注的模拟能力
OPENAI_API_KEY=

# 可选：OpenAI 兼容接口地址。程序会自动追加 /chat/completions。
# DeepSeek 示例：https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：服务端支持的模型名称。DeepSeek 示例：deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# 可选：Semantic Scholar 提升调用额度的密钥；匿名也可检索公开元数据
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=25
SEMANTIC_SCHOLAR_MAX_RESULTS=20
ARXIV_API_URL=https://export.arxiv.org/api/query

# 可选：接口超时与上传限制
LLM_TIMEOUT_SECONDS=60
MAX_PDF_SIZE_MB=20
MAX_UPLOAD_SIZE_MB=30
MAX_PDF_PAGES=80
MAX_PDF_CHARS=40000

# 可选：PDF 证据检索参数
RAG_CHUNK_CHARS=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MAX_DOCUMENTS=5

# 可选：本地多语言向量检索
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_COLLECTION_NAME=evidence_chunks
# 可选值：hybrid（混合检索）、semantic（仅语义）、bm25（仅关键词）
RAG_RETRIEVAL_MODE=hybrid

# 可选：ResearchMind 学术采集与 Zotero 同步
RESEARCHMIND_DATE_FROM=2023-01-01
# 可选：覆盖 ResearchMind SQLite 路径；公网演示应指向隔离数据库
RESEARCHMIND_DB_PATH=
OPENALEX_MAILTO=
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
# user 或 group
ZOTERO_LIBRARY_TYPE=user
ZOTERO_BASE_URL=https://api.zotero.org
